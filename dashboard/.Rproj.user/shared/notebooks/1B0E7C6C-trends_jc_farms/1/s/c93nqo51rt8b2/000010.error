{"frames":[],"message":"Error: Incomplete expression: spc_plot <- function(df, metric, ylab, title) {\n  vals <- na.omit(df[[metric]])\n  mu <- mean(vals)\n  sig <- sd(vals)\n\n  ggplot(df, aes(x = factor(Batch), y = .data[[metric]], group = 1)) +\n    geom_line(color = \"#2E86AB\", linewidth = 0.7) +\n    geom_point(color = \"#2E86AB\", size = 2.5) +\n    geom_hline(aes(yintercept = mu), color = \"#F24236\", linewidth = 0.5) +\n    geom_hline(aes(yintercept = mu + 3 * sig), linetype = \"dashed\", color = \"#F24236\", linewidth = 0.4) +\n    geom_hline(aes(yintercept = mu - 3 * sig), linetype = \"dashed\", color = \"#F24236\", linewidth = 0.4) +\n    labs(x = \"Batch\", y = ylab, title = title) +\n    theme_minimal(base_size = 11)\n"}